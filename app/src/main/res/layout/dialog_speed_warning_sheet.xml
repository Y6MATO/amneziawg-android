<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_server_dialog_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_power_button"
        android:backgroundTint="@color/zaza_sheet_handle" />

    <!-- Big Warning Triangle Icon -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Speed limit warning"
        android:src="@drawable/ic_warning_triangle" />

    <!-- Title: Ограничение скорости -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/unbounded"
        android:gravity="center"
        android:text="Ограничение скорости"
        android:textColor="@color/zaza_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_warning_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/unbounded"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Сервер 🇩🇪 Германия находится в списке специальных серверов и имеет ограниченную скорость"
        android:textColor="@color/zaza_text_secondary"
        android:textSize="13sp" />

    <!-- Primary Action: Подключиться -->
    <FrameLayout
        android:id="@+id/btn_warning_connect"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_btn_purple"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/unbounded"
            android:text="Подключиться"
            android:textColor="@color/zaza_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Secondary Action: Подключиться и больше не показывать -->
    <TextView
        android:id="@+id/btn_warning_connect_dont_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/unbounded"
        android:gravity="center"
        android:padding="8dp"
        android:text="Подключиться и больше не\nпоказывать"
        android:textColor="@color/zaza_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
