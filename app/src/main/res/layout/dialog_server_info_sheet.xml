<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_server_dialog_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_power_button"
        android:backgroundTint="@color/zaza_sheet_handle" />

    <!-- Header: Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_sheet_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Server icon"
            android:src="@drawable/ic_globe"
            app:tint="@color/zaza_purple" />

        <TextView
            android:id="@+id/tv_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="@font/unbounded"
            android:text="Сервер #6"
            android:textColor="@color/zaza_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Description Text -->
    <TextView
        android:id="@+id/tv_sheet_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/unbounded"
        android:lineSpacingExtra="4dp"
        android:text="Работает Telegram, YouTube (Без рекламы), Discord и другие замедленные сервисы. Скорость остаётся обычной, страна не меняется."
        android:textColor="@color/zaza_text_secondary"
        android:textSize="13sp" />

    <!-- Outlined Button: Закрепить / Открепить сервер -->
    <LinearLayout
        android:id="@+id/btn_sheet_pin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_purple_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_sheet_pin_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Pin server"
            android:src="@drawable/ic_pin"
            app:tint="@color/zaza_purple" />

        <TextView
            android:id="@+id/tv_sheet_pin_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/unbounded"
            android:text="Закрепить сервер"
            android:textColor="@color/zaza_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Solid Purple Button: Понятно -->
    <FrameLayout
        android:id="@+id/btn_sheet_dismiss"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_purple"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/unbounded"
            android:text="Понятно"
            android:textColor="@color/zaza_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
